# Copy to .env and fill in. Every setting from python/config_getjudo_default.py
# can be set here under the same name.

# myjudo.eu account
JUDO_USER=
JUDO_PASSWORD=

# MQTT broker
BROKER=192.168.1.2
PORT=1883
USE_MQTT_AUTH=false
MQTTUSER=
MQTTPASSWD=

# Device (topics: LOCATION/NAME/...)
LOCATION=my_location
NAME=Judo_isoftsaveplus
SW_VERSION=2.0
USE_WITH_SOFTWELL_P=false
